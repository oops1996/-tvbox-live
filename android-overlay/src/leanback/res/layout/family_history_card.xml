<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:background="#151920" android:foreground="@drawable/family_card_focus" android:focusable="true" android:focusableInTouchMode="true" android:padding="4dp">
    <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="120dp" android:scaleType="centerCrop" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:progressTint="#F4F5F7" android:progressBackgroundTint="#39404C" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#F4F5F7" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/position" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAB2C0" android:textSize="11sp" android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
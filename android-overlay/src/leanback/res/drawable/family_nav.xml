<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#303743"/><corners android:radius="9dp"/><stroke android:width="2dp" android:color="#F5F6F8"/></shape></item>
    <item android:state_activated="true"><layer-list>
        <item><shape><solid android:color="#20252D"/><corners android:radius="9dp"/></shape></item>
        <item android:width="4dp" android:gravity="left"><shape><solid android:color="#F5F6F8"/><corners android:radius="2dp"/></shape></item>
    </layer-list></item>
    <item><shape><solid android:color="#00000000"/><corners android:radius="9dp"/></shape></item>
</selector>